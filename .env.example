# NarratIQ AI — Environment Variables
# Copy this file to backend/.env and fill in values before running.
# On RunPod: set these as pod environment variables instead of a .env file.
#
# IMPORTANT: Never commit the real .env file to git. This file is safe to commit.

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=narratiq-secret-change-in-production-use-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./narratiq.db

# ── Model base directory ──────────────────────────────────────────────────────
# All model subdirectories live under this path.
# RunPod testing:    /workspace/models   (downloaded from Hugging Face each pod boot)
# RunPod production: /runpod-volume/models  (RunPod Network Volume — persists)
MODEL_BASE_DIR=/workspace/models

# ── Optional: direct model path overrides ─────────────────────────────────────
# Leave empty to use MODEL_BASE_DIR/{folder-name} defaults.
# Override only if you have models stored at non-standard paths.
LLM_MODEL_PATH=
BGE_MODEL_PATH=
TROCR_MODEL_PATH=

# ── Hugging Face model IDs ────────────────────────────────────────────────────
# Used by scripts/download_models.sh. Do not change unless using fine-tuned forks.
LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
BGE_MODEL_ID=BAAI/bge-m3
TROCR_MODEL_ID=microsoft/trocr-large-handwritten

# ── vLLM server ───────────────────────────────────────────────────────────────
# start.sh launches vLLM on port 8001; FastAPI connects here.
VLLM_BASE_URL=http://127.0.0.1:8001/v1
# Must match --served-model-name passed to vLLM in start.sh.
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# ── GPU configuration (used by start.sh to launch vLLM) ──────────────────────
# LEAVE THESE COMMENTED OUT to let start.sh auto-detect based on GPU count.
# Only uncomment and set if you want to force specific values.
#
# start.sh auto-detection table (Qwen2.5-7B-Instruct):
#   1× RTX 4090  → TP=1, GPU_UTIL=0.88, MAX_MODEL_LEN=8192
#   2× RTX 4090  → TP=2, GPU_UTIL=0.90, MAX_MODEL_LEN=16384
#   3× RTX 4090  → TP=2, GPU_UTIL=0.90, MAX_MODEL_LEN=16384  (TP=3 invalid)
#   4× RTX 4090  → TP=4, GPU_UTIL=0.90, MAX_MODEL_LEN=32768
#
# NOTE: Qwen2.5-7B-Instruct has 4 KV heads. TENSOR_PARALLEL_SIZE must
#       evenly divide 4. Valid values: 1, 2, 4  — NOT 3.
#
# GPU_MEMORY_UTILIZATION=0.90
# TENSOR_PARALLEL_SIZE=2
# MAX_MODEL_LEN=16384

# ── Embedding model device ────────────────────────────────────────────────────
# "cpu"  — safe default; 80–150 ms per embedding query, acceptable for most use.
# "cuda" — use when GPU has enough free VRAM above GPU_MEMORY_UTILIZATION.
BGE_DEVICE=cpu

# ── FastAPI server ────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── CORS origins ──────────────────────────────────────────────────────────────
# Add your frontend URL when deploying to RunPod.
# Example: CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Hugging Face token (optional) ────────────────────────────────────────────
# Required only for gated or private models.
# Qwen2.5-7B-Instruct, BGE-M3, and TrOCR-large-handwritten are all public.
HF_TOKEN=
